{
  "multipart": [
    {
      "apply": {
        "model": "openradio:block/feeder_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "openradio:block/feeder_arm"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "openradio:block/feeder_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "openradio:block/feeder_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "openradio:block/feeder_arm",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "openradio:block/feeder_arm_up"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "openradio:block/feeder_arm_down"
      }
    }
  ]
}
